@model List<EnrolmentDto>
@{
    ViewData["Title"] = "Results";
    var events = (List<EventDto>)ViewBag.Events;
    var selected = (int?)ViewBag.SelectedEventId;
    var selectedEvent = events.FirstOrDefault(e => e.EventId == selected);
    var captured = Model.Count(e => e.HasResult);
}
<div class="desk-mast">
    <div class="desk-mast__copy">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a asp-action="Index">Desk</a>
            <span aria-hidden="true">/</span>
            <span class="crumbs__here">Results</span>
        </nav>
        <h1 class="page-title">Chip times</h1>
        <p class="page-lead">@(selectedEvent?.Name ?? "Pick an event") · @captured of @Model.Count captured.</p>
    </div>
    <figure class="desk-mast__shot">
        <img src="~/img/finish-tape.jpg" alt="" width="1200" height="800" />
        <figcaption class="desk-mast__stamp" aria-hidden="true">GUN</figcaption>
    </figure>
</div>
<div class="page-wrap">
    @if (events.Count == 0)
    {
        <div class="empty-desk">
            <p class="empty-desk__kicker">Times</p>
            <h2>Create an event first</h2>
            <p>Results are captured against confirmed enrolments.</p>
            <a class="btn btn-tape" asp-action="CreateEvent">Create event</a>
        </div>
    }
    else
    {
        <form method="get" class="filter-bar">
            <div class="field mb-0">
                <label class="form-label" for="eventId">Event</label>
                <select class="form-select" id="eventId" name="eventId" onchange="this.form.submit()">
                    @foreach (var item in events)
                    {
                        if (item.EventId == selected)
                        {
                            <option value="@item.EventId" selected>@item.Name</option>
                        }
                        else
                        {
                            <option value="@item.EventId">@item.Name</option>
                        }
                    }
                </select>
            </div>
            <noscript><button class="btn btn-tape" type="submit">Show</button></noscript>
        </form>
        @if (Model.Count == 0)
        {
            <div class="empty-desk">
                <p class="empty-desk__kicker">Times</p>
                <h2>No field to time</h2>
                <p>Wait for enrolments, then capture chip time as hh:mm:ss and a finishing position.</p>
            </div>
        }
        else
        {
            <div class="sheet sheet--desk">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="Participant">@item.ParticipantName</td>
                            <td data-label="Category">@item.CategoryName</td>
                            <td data-label="Status"><partial name="_StatusChip" model="item.Status" /></td>
                            <td data-label="Result">
                                @if (item.HasResult)
                                {
                                    <span class="tape-stamp">Captured</span>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-tape" asp-action="CaptureResult" asp-route-enrolmentId="@item.EnrolmentId" asp-route-eventId="@selected">Capture result</a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <details class="help-fold">
            <summary>How to capture a time</summary>
            <p>Open Capture result on a row. Enter chip time as hours, minutes and seconds (01:30:00) and the finishing position. Cancel returns here without saving.</p>
        </details>
    }
</div>
