@model List<EnrolmentDto>
@{
    ViewData["Title"] = "Enrolments";
    var events = (List<EventDto>)ViewBag.Events;
    var selected = (int?)ViewBag.SelectedEventId;
}
<div class="page-wrap">
    <partial name="_Alerts" />
    <h1 class="page-title">Enrolments</h1>
    @if (events.Count == 0)
    {
        <p>Create an event first.</p>
    }
    else
    {
        <form method="get" class="mb-3" style="max-width:24rem">
            <label class="form-label" for="eventId">Event</label>
            <select class="form-select" id="eventId" name="eventId" onchange="this.form.submit()">
                @foreach (var item in events)
                {
                    if (item.EventId == selected)
                    {
                        <option value="@item.EventId" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.EventId">@item.Name</option>
                    }
                }
            </select>
        </form>
        <div class="sheet">
            <table class="ops-table">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="Participant">@item.ParticipantName<br /><span class="start-meta">@item.ParticipantEmail</span></td>
                        <td data-label="Category">@item.CategoryName</td>
                        <td data-label="Status"><partial name="_StatusChip" model="item.Status" /></td>
                        <td>
                            <form asp-action="UpdateEnrolmentStatus" method="post" class="d-flex gap-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="enrolmentId" value="@item.EnrolmentId" />
                                <input type="hidden" name="eventId" value="@selected" />
                                <select name="status" class="form-select form-select-sm">
                                    <option>Pending</option>
                                    <option>Confirmed</option>
                                    <option>Cancelled</option>
                                </select>
                                <button class="btn btn-sm btn-asphalt" type="submit">Save</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            @if (Model.Count == 0)
            {
                <p class="p-3 mb-0">Nobody has entered this event yet.</p>
            }
        </div>
    }
</div>
