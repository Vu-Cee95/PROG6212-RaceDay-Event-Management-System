@model List<EnrolmentDto>
@{
    ViewData["Title"] = "Enrolments";
    var events = (List<EventDto>)ViewBag.Events;
    var selected = (int?)ViewBag.SelectedEventId;
    var selectedEvent = events.FirstOrDefault(e => e.EventId == selected);
}
<div class="desk-mast">
    <div class="desk-mast__copy">
        <nav class="crumbs" aria-label="Breadcrumb">
            <a asp-action="Index">Desk</a>
            <span aria-hidden="true">/</span>
            <span class="crumbs__here">Enrolments</span>
        </nav>
        <h1 class="page-title">Field list</h1>
        <p class="page-lead">@(selectedEvent?.Name ?? "Pick an event") · Confirm or cancel entries. Current status is selected in each row.</p>
    </div>
    <figure class="desk-mast__shot">
        <img src="~/img/hero-start.jpg" alt="" width="1600" height="900" />
        <figcaption class="desk-mast__stamp" aria-hidden="true">IN</figcaption>
    </figure>
</div>
<div class="page-wrap">
    @if (events.Count == 0)
    {
        <div class="empty-desk">
            <p class="empty-desk__kicker">Field</p>
            <h2>Create an event first</h2>
            <p>Enrolments appear here once a race exists and someone enters it.</p>
            <a class="btn btn-tape" asp-action="CreateEvent">Create event</a>
        </div>
    }
    else
    {
        <form method="get" class="filter-bar">
            <div class="field mb-0">
                <label class="form-label" for="eventId">Event</label>
                <select class="form-select" id="eventId" name="eventId" onchange="this.form.submit()">
                    @foreach (var item in events)
                    {
                        if (item.EventId == selected)
                        {
                            <option value="@item.EventId" selected>@item.Name</option>
                        }
                        else
                        {
                            <option value="@item.EventId">@item.Name</option>
                        }
                    }
                </select>
            </div>
            <noscript><button class="btn btn-tape" type="submit">Show</button></noscript>
        </form>
        @if (Model.Count == 0)
        {
            <div class="empty-desk">
                <p class="empty-desk__kicker">Field</p>
                <h2>Nobody has entered this event yet</h2>
                <p>Participants choose a category from the public start list. Refresh this page after the first entry.</p>
            </div>
        }
        else
        {
            <div class="sheet sheet--desk">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Change status</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="Participant">@item.ParticipantName<br /><span class="start-meta">@item.ParticipantEmail</span></td>
                            <td data-label="Category">@item.CategoryName</td>
                            <td data-label="Status"><partial name="_StatusChip" model="item.Status" /></td>
                            <td data-label="Change status">
                                <form asp-action="UpdateEnrolmentStatus" method="post" class="d-flex gap-1 flex-wrap">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="enrolmentId" value="@item.EnrolmentId" />
                                    <input type="hidden" name="eventId" value="@selected" />
                                    <label class="visually-hidden" for="status-@item.EnrolmentId">Status for @item.ParticipantName</label>
                                    <select id="status-@item.EnrolmentId" name="status" class="form-select">
                                        @if (item.Status == "Pending") { <option selected>Pending</option> } else { <option>Pending</option> }
                                        @if (item.Status == "Confirmed") { <option selected>Confirmed</option> } else { <option>Confirmed</option> }
                                        @if (item.Status == "Cancelled") { <option selected>Cancelled</option> } else { <option>Cancelled</option> }
                                    </select>
                                    <button class="btn btn-sm btn-asphalt" type="submit" data-busy="Saving…">Save</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        <details class="help-fold">
            <summary>How status works</summary>
            <p>Pending is a new entry. Confirmed means they are on the start list. Cancelled removes them from results capture. Saving writes through the API, not the MVC database.</p>
        </details>
    }
</div>
