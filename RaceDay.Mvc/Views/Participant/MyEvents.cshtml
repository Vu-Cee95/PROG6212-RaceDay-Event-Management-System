@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My events";
}
<div class="page-wrap">
    <partial name="_Alerts" />
    <h1 class="page-title">My events</h1>
    @if (Model.Count == 0)
    {
        <p>You have not entered an event yet. Open Events and choose a category.</p>
    }
    else
    {
        <div class="sheet">
            <table class="ops-table">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="Event">@item.EventName</td>
                        <td data-label="Date" class="mono">@item.EventDate.ToString("dd MMM yyyy")</td>
                        <td data-label="Category">@item.CategoryName</td>
                        <td data-label="Status"><partial name="_StatusChip" model="item.Status" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
