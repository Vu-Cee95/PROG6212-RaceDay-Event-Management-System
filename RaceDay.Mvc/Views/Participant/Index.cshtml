@model List<EventDto>
@{
    ViewData["Title"] = "Events";
    var type = ViewBag.Type as string;
    var search = ViewBag.Search as string;
    var types = (string[])ViewBag.Types;
}
<div class="page-wrap">
    <partial name="_Alerts" />
    <h1 class="page-title">Events</h1>
    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label class="form-label" for="search">Search</label>
            <input class="form-control" id="search" name="search" value="@search" placeholder="Name or location" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="type">Type</label>
            <select class="form-select" id="type" name="type">
                <option value="">All</option>
                @foreach (var t in types)
                {
                    if (string.Equals(t, type, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@t" selected>@t</option>
                    }
                    else
                    {
                        <option value="@t">@t</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-tape" type="submit">Filter</button>
        </div>
    </form>
    @if (Model.Count == 0)
    {
        <p>No events match that filter.</p>
    }
    else
    {
        <div class="start-list">
            @foreach (var item in Model)
            {
                <article class="start-row">
                    <div class="start-row__bib">@item.Distance.ToString("0.#")</div>
                    <div>
                        <h2>@item.Name</h2>
                        <p class="start-meta mb-0">@item.EventType · @item.Location · <span class="mono">@item.EventDate.ToString("dd MMM yyyy")</span> · @(item.EventDate.Date >= DateTime.Today ? "Upcoming" : "Past")</p>
                    </div>
                    <a class="btn btn-asphalt" asp-action="Details" asp-route-id="@item.EventId">Details</a>
                </article>
            }
        </div>
    }
</div>
