@{
    var role = Context.Session.GetString(SessionKeys.Role);
    var userId = Context.Session.GetInt32(SessionKeys.UserId);
    var displayName = Context.Session.GetString(SessionKeys.DisplayName);
    var overHero = ViewData["OverHero"] as bool? == true;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool On(string c, params string[] actions) =>
        string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase)
        && (actions.Length == 0 || actions.Any(a => string.Equals(act, a, StringComparison.OrdinalIgnoreCase)));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "RaceDay")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=Orbitron:wght@400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(overHero ? "has-hero cm-body" : "cm-body")">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="lane-progress" aria-hidden="true"></div>
    <header class="ops-bar cm-bar">
        <nav class="navbar navbar-expand-lg ops-nav cm-nav" aria-label="RaceDay">
            <div class="container-fluid ops-nav__inner cm-nav__inner">
                <a class="navbar-brand ops-brand cm-brand" asp-controller="Home" asp-action="Index">RaceDay</a>
                <button class="navbar-toggler ops-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#opsNav" aria-controls="opsNav" aria-expanded="false" aria-label="Open menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="opsNav">
                    <ul class="navbar-nav ms-auto cm-nav__links">
                        @if (userId is null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" aria-current="@(On("Home", "Index") ? "page" : null)">Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Register" aria-current="@(On("Auth", "Register") ? "page" : null)">Register</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login" aria-current="@(On("Auth", "Login") ? "page" : null)">Login</a></li>
                        }
                        else if (string.Equals(role, "Organiser", StringComparison.OrdinalIgnoreCase))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index" aria-current="@(On("Organiser", "Index") ? "page" : null)">Desk</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events" aria-current="@(On("Organiser", "Events", "CreateEvent", "EditEvent", "Categories") ? "page" : null)">Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Enrolments" aria-current="@(On("Organiser", "Enrolments", "UpdateEnrolmentStatus") ? "page" : null)">Enrolments</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Results" aria-current="@(On("Organiser", "Results", "CaptureResult") ? "page" : null)">Results</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Index" aria-current="@(On("Participant", "Index", "Details") ? "page" : null)">Events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents" aria-current="@(On("Participant", "MyEvents") ? "page" : null)">My events</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults" aria-current="@(On("Participant", "MyResults") ? "page" : null)">My results</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile" aria-current="@(On("Participant", "Profile") ? "page" : null)">Profile</a></li>
                        }
                    </ul>
                    @if (userId is not null)
                    {
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="ops-logout">
                            @Html.AntiForgeryToken()
                            <span class="ops-role">@role</span>
                            <span class="ops-user">@displayName</span>
                            <button type="submit" class="btn btn-sm btn-tape" data-busy="Logging out…">Log out</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main id="main">
        <div class="page-wrap alerts-host" aria-live="polite">
            <partial name="_Alerts" />
        </div>
        @RenderBody()
    </main>
    <footer class="ops-foot cm-foot">
        <div class="container-fluid ops-foot__inner cm-foot__inner">
            <span class="ops-brand ops-brand--foot">RaceDay</span>
            <span class="ops-foot__meta">Race events for participants and organisers.</span>
        </div>
    </footer>
    <dialog class="rd-dialog" id="rd-confirm" aria-labelledby="rd-confirm-title">
        <form method="dialog" class="rd-dialog__body">
            <h2 id="rd-confirm-title" class="page-title">Confirm</h2>
            <p id="rd-confirm-text"></p>
            <div class="form-actions">
                <button value="cancel" class="btn btn-ghost">Cancel</button>
                <button value="ok" class="btn btn-tape">Yes, continue</button>
            </div>
        </form>
    </dialog>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/motion/motion.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
