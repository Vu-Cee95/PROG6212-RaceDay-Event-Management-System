@model List<EventDto>
@{
    ViewData["Title"] = "RaceDay";
    ViewData["OverHero"] = true;
}
<section class="plx" aria-label="RaceDay start">
    <img class="plx__layer" style="--depth:-0.25" src="~/img/hero-start.jpg" alt="" width="1600" height="900" />
    <div class="plx__layer plx__mist" style="--depth:0.1" aria-hidden="true"></div>
    <div class="plx__copy plx__layer" style="--depth:0.22">
        <h1>Race operations, not a brochure.</h1>
        <p>Enter a road race, walk or cycle. Organisers run the desk: fields, categories, enrolments and official times.</p>
        <a class="btn btn-tape" asp-controller="Auth" asp-action="Register">Register</a>
        <a class="btn btn-asphalt ms-2" asp-controller="Auth" asp-action="Login">Log in</a>
    </div>
</section>
<div class="page-wrap">
    <h2 class="page-title">Start list</h2>
    <p class="page-lead">Log in as a participant to enter. Organisers manage their own events after login.</p>
    @if (Model.Count == 0)
    {
        <p>No upcoming events are listed yet.</p>
    }
    else
    {
        <div class="start-list">
            @foreach (var item in Model)
            {
                <article class="start-row">
                    <div class="start-row__bib">@item.Distance.ToString("0.#")</div>
                    <div>
                        <h2>@item.Name</h2>
                        <p class="start-meta mb-0">@item.EventType · @item.Location · <span class="mono">@item.EventDate.ToString("dd MMM yyyy")</span> · @(item.EventDate.Date >= DateTime.Today ? "Upcoming" : "Past")</p>
                    </div>
                    <a class="btn btn-asphalt" asp-controller="Auth" asp-action="Login">Log in to enter</a>
                </article>
            }
        </div>
    }
</div>
